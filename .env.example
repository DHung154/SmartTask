# ---------------------------------------------------------------
# File cấu hình mẫu
#
# Copy file này thành .env rồi sửa giá trị cho khớp máy của bạn:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS / Linux)
#
# File .env KHÔNG được commit lên git (đã có trong .gitignore).
# ---------------------------------------------------------------

# --- Database ---
# Mặc định bên dưới khớp với XAMPP (user root, không mật khẩu)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=todo_schema
DB_USER=root
DB_PASS=

# --- Ứng dụng ---
# APP_DEBUG=true  : hiện chi tiết lỗi ra màn hình (chỉ dùng khi đang code)
# APP_DEBUG=false : chỉ hiện thông báo lỗi thân thiện (dùng khi demo/nộp bài)
APP_DEBUG=true

# --- Gmail SMTP ---
# Gmail bat buoc dung App Password, khong dung mat khau dang nhap Gmail.
APP_URL=http://todophp.test
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=TodoPHP
